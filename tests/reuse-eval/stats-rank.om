note units: stats
note SPDX-License-Identifier: Apache-2.0
note stats-rank: the nearest-rank rule, the heap sort, category quantiles, splitmix64 known answers
note (reference splitmix64.c, seed 1234567) and the exact 128-bit floor(a b / c) with saturation.
note Exit 0 = pass; otherwise the failing check's code.

fn trk to int
if ne strank 25 10000 249
ret 1
end
if ne strank 975 10000 9749
ret 2
end
if ne strank 500 24 11
ret 3
end
if ne strank 950 24 22
ret 4
end
if ne strank 990 1 0
ret 5
end
if ne strank 500 2 0
ret 6
end
if ne strank 950 3 2
ret 7
end
ret 0
end

note values 1..100 in the order i 37 mod 101; even values belong to session 0 (type S), odd to 1 (Z)
fn tqfill to void
for i ulong 100
v = rem mul add i 1 37 101
put STQV i v
put STQI i rem v 2
end
put STNS 0 2
put STST 0 2
put STST 1 1
put STSN 0 2
put STSN 1 4
put STSF 0 1
put STSF 1 2
put STSC 0 0
put STSC 1 1
end

fn tqs to int
tqfill
stsort 100
for i ulong 100
if ne get STQV i add i 1
ret 11
end
if ne get STQI i rem add i 1 2
ret 12
end
end
if ne stqpick 100 0 strank 500 100 50
ret 13
end
if ne stqpick 100 0 strank 950 100 95
ret 14
end
if ne stqpick 100 0 strank 990 100 99
ret 15
end
if ne stqpick 100 2 strank 500 50 50
ret 16
end
if ne stqpick 100 2 strank 950 50 96
ret 17
end
if ne stqpick 100 2 strank 990 50 100
ret 18
end
if ne stqpick 100 1 strank 500 50 49
ret 19
end
if ne stqpick 100 1 strank 950 50 95
ret 20
end
if ne stqpick 100 16 strank 990 50 99
ret 21
end
ret 0
end

fn tsm to int
put STRNG 0 1234567
if ne stsm 6457827717110365317
ret 31
end
if ne stsm 3203168211198807973
ret 32
end
if ne stsm 9817491932198370423
ret 33
end
ret 0
end

fn tmd to int
m = ulong 18446744073709551615
if ne stmd m m m m
ret 41
end
if ne stmd 10000000000000 1000000 3 3333333333333333333
ret 42
end
if ne stmd m 2 1 m
ret 43
end
if ne stmd 7 1000000 3 2333333
ret 44
end
if ne stppm 1 3 333333
ret 45
end
if ne stppms -7 2 -3500000
ret 46
end
if ne stmd 5 5 0 m
ret 47
end
ret 0
end

fn main to int
r = trk
if ne r 0
ret r
end
r = tqs
if ne r 0
ret r
end
r = tsm
if ne r 0
ret r
end
ret tmd
end
