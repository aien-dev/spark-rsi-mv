note units: sha256 ref judge
note SPDX-License-Identifier: Apache-2.0
fn main to int
n = ulong 0
n = jdpair 0 30 n
n = jdpair 0 10 n
n = jdpair 0 20 n
n = jdpair 12 8 n
n = jdpair 12 4 n
n = jdpair 24 6 n
n = jdpair 24 2 n
n = jdpair 72 19 n
n = jdpair 200 120 n
n = jdpair 200 100 n
n = jdpair 100 190 n
n = jdpair 100 150 n
n = jdpair 205 1000 n
n = jdpair 105 1200 n
jdcalout n 12345
if ne get JDM JMEX 3544386010811150674
ret 1
end
if ne get JDM add JMEX 2 12345
ret 2
end
if ne get JDM add JMEX 8 20
ret 3
end
if ne get JDM add JMEX 9 30
ret 4
end
if ne get JDM add JMEX 32 4
ret 5
end
if ne get JDM add JMEX 33 8
ret 6
end
if ne get JDM add JMEX 56 2
ret 7
end
if ne get JDM add JMEX 152 19
ret 8
end
if ne get JDM add JMEX 80 50
ret 9
end
if ne get JDM add JMEX 81 90
ret 10
end
if ne get JDM add JMEX 192 200
ret 11
end
if ne get JDM add JMEX 193 200
ret 12
end
if ne get JDM add JMEX 190 0
ret 13
end
if ne jdfloor1 10 20 1
ret 14
end
if ne jdccls 0 0
ret 15
end
if ne jdccls 1 1
ret 16
end
if ne jdccls 64 2
ret 17
end
if ne jdccls 65 3
ret 18
end
note Harness mutant: change one expected value and require correctness to flip to wrong.
put JDM JMEX 0
put JDM add JMEX 2 17
put JDM add JMEX 3 2
put JDC 10 1
if ne jdcorr 2 0 0 17 2 JMEX 1
ret 19
end
put JDM add JMEX 2 18
if ne jdcorr 2 0 0 17 2 JMEX 0
ret 20
end
ret 0
end
