note units: sha256 ref judge
note fixture: drive
note SPDX-License-Identifier: Apache-2.0
note Fake drive for testing acquisition accounting and printed-manifest capture, not candidate code.
text FDMS "manifest_sha256=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\ngeneration=1\ntemplates=0\n"
text FDFAIL "fail10"
fn main to int
if lt argcnt 6
ret 2
end
b = jdsarg 9 5
if eq argcnt 7
b = jdsarg 0 6
if eq jdspack 0 52988830376294
ret 10
end
end
r = jdmkdir 9 448
jdspath 0 9 JWGEN 4
jdsnum 0 1 1
jdsw 0 JWELF 4
for i ulong 37
put JDF i uchar i
end
x = jdwrf 0 37 705
r = sleepns 2000000
n = write 1 FDMS 0 len FDMS
ret 0
end
