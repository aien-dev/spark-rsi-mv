note units: sha256 ref
note needs: gen
note gen-train: TRAIN, TRAINP and CALIB are what contract 7.1 / 7.2 and clarification K8 (f, g) say.
note Generates the three splits into argv[1]; replays every request through ref.om and checks the
note index (magic, version, split id, groups, sessions, request and QUERY counts, group counts,
note holdout digest), every .exp record, the sessions file (ordinal, group, type, family, n class,
note n in {64, 512, 4096}, shape id, program digest, counts, first request index). TRAIN and TRAINP:
note BEGIN + 8 x (SET, QUERY); session s is FSM iff s mod 6 = 5; 10 distinct machines used 4 times
note each, 5 of them permutation machines; at most 24 AGG shapes; at least 50 AGG sessions repeat an
note earlier AGG program exactly; TRAINP's AGG shapes are disjoint from TRAIN's. CALIB: BEGIN +
note 16 x (change, QUERY) with one change class per session (0, 1, 2..64, > 64; only SET and BATCH
note of SET), the session type matching it, and every family x n class x change class cell (the
note R1CAL001 cells) holding at least 4 sessions.
note Exit 0 pass; 1 args; 2 a gen run failed; codes 20..76 name the failed check.
text tgnull "/dev/null"
text tgs1 "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
global TGB uchar 16777216
global TGC uchar 16777216
global TGP uchar 4096
global TGK uchar 4096
global TGA uchar 4096
global TGS uchar 4096
global TGT ulong 16
global TGST uchar 4
global TGIX ulong 128
global TGSS ulong 3840
global TGPR ulong 15360
global TGSH ulong 240
global TGCU ulong 32
global TGOP ulong 256
global TGQ ulong 4097
global TGCN ulong 64

note TGT: 0 scratch length, 1 gen path length, 2 path length, 3 packet position, 4 record count,
note 5 directory path length
note TGCU: 0 open session (1), 1 session requests, 2 session QUERYs, 3 cold pending, 5 family,
note 7 ordinal, 8 first failure, 9 requests, 10 QUERYs, 11 slot in group, 12 group,
note 14 changes since the previous QUERY, 15 session change class, 16 split id

fn tgpput v ulong n ulong to void
l = get TGT 2
x = v
for i ulong n
put TGP add l i uchar and x 255
x = shr x 8
end
put TGT 2 add l n
end

fn tgdir c ulong to void
l = get TGT 0
for i ulong l
put TGP i get TGS i
end
put TGT 2 l
tgpput add 47 mul c 256 2
put TGT 5 get TGT 2
end

fn tgfile v ulong n ulong to void
put TGT 2 get TGT 5
tgpput 47 1
tgpput v n
end

fn tggfile g ulong ext ulong to void
put TGT 2 get TGT 5
tgpput 26415 2
tgpput add 48 div g 10 1
tgpput add 48 rem g 10 1
if eq ext 0
tgpput 1902473774 4
else
tgpput 1886938414 4
end
end

fn tgkhdr n ulong to ulong
p = get TGT 3
put TGK p uchar and n 255
put TGK add p 1 uchar shr n 8
put TGT 3 add p add n 2
put TGT 4 add get TGT 4 1
ret add p 2
end

fn tgkgen to void
n = get TGT 1
p = tgkhdr n
for i ulong n
put TGK add p i get TGA i
end
end

fn tgkval v ulong n ulong to void
p = tgkhdr n
x = v
for i ulong n
put TGK add p i uchar and x 255
x = shr x 8
end
end

fn tgkpath to void
n = get TGT 2
p = tgkhdr n
for i ulong n
put TGK add p i get TGP i
end
end

fn tgkseed to void
p = tgkhdr 64
for i ulong 64
put TGK add p i get tgs1 i
end
end

fn tgexec to ulong
put TGK 0 uchar get TGT 4
put TGK 1 0
pid = fork
if lt pid 0
ret 256
end
if eq pid 0
fd = fopen tgnull 0 len tgnull 1 0
if ge fd 0
d = dupfd int fd 1 0
end
r = execprog TGK 0 get TGT 3
exit 97
end
w = waitpid int pid TGST 0 4 0
if or ne w pid ne get TGST 0 0
ret 256
end
ret ulong get TGST 1
end

fn tggen v ulong n ulong c ulong w ulong to ulong
put TGT 3 2
put TGT 4 0
tgkgen
tgkval v n
tgdir c
tgkpath
if ne w 0
tgkseed
end
ret tgexec
end

fn tgreadb to ulong
fd = fopen TGP 0 get TGT 2 0 0
if lt fd 0
ret 0
end
n = read int fd TGB 0 len TGB
x = fclose int fd
if lt n 0
ret 0
end
ret ulong n
end

fn tgreadc to ulong
fd = fopen TGP 0 get TGT 2 0 0
if lt fd 0
ret 0
end
n = read int fd TGC 0 len TGC
x = fclose int fd
if lt n 0
ret 0
end
ret ulong n
end

fn tgwb i ulong to ulong
v = ulong 0
b = mul i 8
for j ulong 8
v = or v shl ulong get TGB add b j mul j 8
end
ret v
end

fn tgwc i ulong to ulong
v = ulong 0
b = mul i 8
for j ulong 8
v = or v shl ulong get TGC add b j mul j 8
end
ret v
end

fn tgerr code ulong to void
if eq get TGCU 8 0
put TGCU 8 code
end
end


fn tgperm to bool
s = get RFP 2
a = get RFP 3
for x ulong a
seen = ulong 0
for st ulong s
t = rfdelta st x
b = shl ulong 1 t
if ne and seen b 0
ret false
end
seen = or seen b
end
end
ret true
end


fn tgabs nb ulong to void
off = ulong 0
while lt off nb bound 999
k = sub nb off
if gt k 65536
k = 65536
end
for i ulong k
put RFHB i get TGB add off i
end
rfhabs 0 k
off = add off k
end
end


note the expected record k against the reference's response; per-QUERY change class
fn tgexpchk k ulong op ulong st ulong to void
b = mul k 8
if ne st 0
tgerr 50
end
if ne tgwc b 0
tgerr 51
end
if ne tgwc add b 1 get RFRS 1
tgerr 51
end
if ne tgwc add b 2 get RFRS 2
tgerr 52
end
if ne tgwc add b 3 get RFRS 3
tgerr 52
end
if ne tgwc add b 4 op
tgerr 53
end
if ne tgwc add b 5 get TGCU 7
tgerr 53
end
cold = ulong 0
if eq op 2
if eq get TGCU 3 1
cold = 1
end
put TGCU 3 0
put TGCU 2 add get TGCU 2 1
put TGCU 10 add get TGCU 10 1
tgqclass
end
if or eq op 1 eq op 8
put TGCU 3 1
end
if ne tgwc add b 6 cold
tgerr 54
end
if ne tgwc add b 7 0
tgerr 54
end
end

note change class of the changes since the previous QUERY: 0, 1, 2..64, > 64; all QUERYs of a
note session must have the same class (TGCU 15, 9 = not yet seen)
fn tgqclass to void
n = get TGCU 14
c = ulong 3
if le n 64
c = 2
end
if le n 1
c = n
end
if eq get TGCU 15 9
put TGCU 15 c
end
if ne get TGCU 15 c
tgerr 58
end
put TGCU 14 0
end

fn tgrec i ulong to ulong
ret get TGSS add mul get TGCU 7 16 i
end

fn tgendsess to void
if eq get TGCU 0 0
ret
end
put TGCU 0 0
nr = get TGCU 1
nq = get TGCU 2
if ne tgrec 12 nr
tgerr 20
end
if ne tgrec 13 nq
tgerr 20
end
if ne get TGOP sub nr 1 2
tgerr 21
end
cl = get TGCU 15
sid = get TGCU 16
if eq sid 2
if ne nq 16
tgerr 21
end
want = ulong 33
if eq cl 0
want = 17
end
if ne nr want
tgerr 21
end
typ = ulong 3
if lt cl 2
typ = add cl 1
end
if ne tgrec 3 typ
tgerr 27
end
fm = sub get TGCU 5 1
nc = tgrec 5
c = add mul fm 12 add mul nc 4 cl
put TGCN c add get TGCN c 1
else
if or ne nq 8 ne nr 17
tgerr 21
end
if ne cl 1
tgerr 21
end
if ne tgrec 3 2
tgerr 27
end
end
end

fn tgnewsess k ulong to void
tgendsess
ord = add mul get TGCU 12 8 get TGCU 11
put TGCU 11 add get TGCU 11 1
put TGCU 7 ord
put TGCU 0 1
put TGCU 1 0
put TGCU 2 0
put TGCU 14 0
put TGCU 15 9
if ge ord 240
tgerr 22
put TGCU 7 0
ret
end
if ne tgrec 0 ord
tgerr 22
end
if ne tgrec 1 get TGCU 12
tgerr 22
end
if ne tgrec 14 k
tgerr 22
end
if ne tgrec 15 0
tgerr 22
end
if ne tgrec 4 0
tgerr 22
end
end

fn tgbegpost to void
n = get RFN 0
if ne tgrec 2 get RFP 1
tgerr 23
end
if ne tgrec 6 n
tgerr 23
end
nc = tgrec 5
want = ulong 64
if eq nc 1
want = 512
end
if eq nc 2
want = 4096
end
if or gt nc 2 ne n want
tgerr 24
end
if ne tgrec 7 rfshape
tgerr 25
end
rfpdig
for j ulong 4
if ne tgrec add 8 j get RFPD j
tgerr 26
end
end
put TGCU 5 get RFP 1
o = get TGCU 7
for i ulong 64
put TGPR add mul o 64 i get RFP i
end
end

fn tgchg op ulong to void
sid = get TGCU 16
if eq op 3
put TGCU 14 add get TGCU 14 1
ret
end
if and eq op 7 eq sid 2
m = get RFRQ 2
for i ulong m
if ne get RFRQ add 3 mul i 3 3
tgerr 42
end
end
put TGCU 14 add get TGCU 14 m
ret
end
tgerr 42
end

fn tgstep w ulong k ulong to ulong
op = tgwb w
p = tgwb add w 1
if gt p 7234
tgerr 55
ret 18446744073709551615
end
for j ulong add p 2
put RFRQ j tgwb add w j
end
if eq op 1
tgnewsess k
else
if ne op 2
tgchg op
end
end
st = ulong rfreq
if eq op 1
tgbegpost
end
tgexpchk k op st
r = get TGCU 1
if lt r 256
put TGOP r op
end
put TGCU 1 add r 1
put TGCU 9 add get TGCU 9 1
ret add w add p 2
end

fn tggroup c ulong g ulong to void
tgdir c
tggfile g 0
nb = tgreadb
tgdir c
tggfile g 1
ne8 = tgreadc
tgabs nb
nw = div nb 8
put TGCU 12 g
put TGCU 11 0
rfreset
w = ulong 0
k = ulong 0
while lt w nw bound 99999
w = tgstep w k
k = add k 1
end
tgendsess
if ne w nw
tgerr 56
end
if ne mul k 64 ne8
tgerr 56
end
if ne get TGCU 11 8
tgerr 57
end
gc = get TGIX add 16 g
if ne k gc
tgerr 57
end
end

note index and sessions of directory c into TGIX / TGSS for split sid with G groups
fn tgload c ulong sid ulong g ulong to ulong
s = mul g 8
tgdir c
tgfile 517097156201 5
if ne tgreadb mul add 16 g 8
ret 60
end
for i ulong add 16 g
put TGIX i tgwb i
end
tgdir c
tgfile 8317708060499076467 8
if ne tgreadb mul s 128
ret 61
end
for j ulong mul s 16
put TGSS j tgwb j
end
if ne get TGIX 0 3544386032354079058
ret 62
end
if ne get TGIX 1 1
ret 62
end
if ne get TGIX 2 sid
ret 62
end
if ne get TGIX 3 g
ret 62
end
if ne get TGIX 4 s
ret 63
end
for z ulong 5
if ne get TGIX add 11 z 0
ret 62
end
end
ret 0
end

fn tgsplit c ulong sid ulong g ulong nr ulong nq ulong to ulong
e = tgload c sid g
if ne e 0
ret e
end
for u ulong 64
put TGCN u 0
end
put TGCU 8 0
put TGCU 9 0
put TGCU 10 0
put TGCU 16 sid
rfhini 0
tot = ulong 0
for i ulong g
tggroup c i
tot = add tot get TGIX add 16 i
end
if ne get TGCU 8 0
ret get TGCU 8
end
rfhfin 0
for d ulong 4
if ne get RFHD d get TGIX add 7 d
ret 64
end
end
if or ne tot nr ne get TGIX 5 nr
ret 65
end
if or ne get TGCU 9 nr ne get TGIX 6 nq
ret 65
end
if ne get TGCU 10 nq
ret 65
end
ret 0
end

note ---- split-level checks on the BEGIN programs TGPR ----

fn tgpreq a ulong b ulong to bool
for j ulong 64
if ne get TGPR add mul a 64 j get TGPR add mul b 64 j
ret false
end
end
ret true
end

fn tgrfp r ulong to void
for j ulong 64
put RFP j get TGPR add mul r 64 j
end
end

note rows equal to row s (s included); TGCU 20 = 1 when an earlier row is equal
fn tgdup s ulong to ulong
put TGCU 20 0
cnt = ulong 0
for t ulong 240
if tgpreq s t
if lt t s
put TGCU 20 1
end
cnt = add cnt 1
end
end
ret cnt
end

note TRAIN / TRAINP: families by ordinal, 10 machines x 4 (5 permutation), at most 24 AGG shapes,
note at least 50 AGG sessions repeating an earlier AGG program; shapes kept in TGSH (which 1 TRAIN)
note or checked disjoint from them (which 5)
fn tglist which ulong to ulong
mach = ulong 0
perms = ulong 0
reuse = ulong 0
for s ulong 240
f = get TGPR add mul s 64 1
want = ulong 1
if eq rem s 6 5
want = 2
end
if ne f want
ret 70
end
cnt = tgdup s
first = eq get TGCU 20 0
tgrfp s
if eq f 2
if ne cnt 4
ret 71
end
if first
mach = add mach 1
if tgperm
perms = add perms 1
end
end
else
if not first
reuse = add reuse 1
end
sh = rfshape
if eq which 1
put TGSH s sh
else
if tghas sh
ret 74
end
end
end
end
if or ne mach 10 ne perms 5
ret 72
end
if lt reuse 50
ret 73
end
if gt tgnshape 24
ret 75
end
ret 0
end

fn tghas sh ulong to bool
for s ulong 240
if and ne rem s 6 5 eq get TGSH s sh
ret true
end
end
ret false
end

note distinct AGG shapes of the current split (TGPR rows)
fn tgnshape to ulong
d = ulong 0
for s ulong 240
if ne rem s 6 5
tgrfp s
sh = rfshape
put TGQ s sh
seen = false
for t ulong s
if and ne rem t 6 5 eq get TGQ t sh
seen = true
end
end
if not seen
d = add d 1
end
end
end
ret d
end

note CALIB: every cell family x n class x change class has at least 4 sessions
fn tgcells to ulong
for c ulong 24
if lt get TGCN c 4
ret 76
end
end
ret 0
end

fn main to int
if lt argcnt 3
ret 1
end
l = argread 1 TGS 0 3000
m = argread 2 TGA 0 3000
if or le l 0 le m 0
ret 1
end
put TGT 0 ulong l
put TGT 1 ulong m
r = tggen 336236466772 5 84 0
r = or r tggen 88297166688852 6 80 0
r = or r tggen 284697575747 5 67 0
if ne r 0
ret 2
end
e = tgsplit 84 1 30 4080 1920
if ne e 0
ret int e
end
e = tglist 1
if ne e 0
ret int e
end
e = tgsplit 80 5 30 4080 1920
if ne e 0
ret int e
end
e = tglist 5
if ne e 0
ret int e
end
e = tgsplit 67 2 12 2784 1536
if ne e 0
ret int e
end
ret int tgcells
end
