note units: stats
note SPDX-License-Identifier: Apache-2.0
note stats-decide: the contract 10 decision (with K7 control outcomes) as a truth table over the
note globals stdecide reads. Every STOP, GO and INVESTIGATE branch and the boundary values
note (ppm 999999 versus 1000000, coverage exactly one half, no transfer QUERY) are covered.
note Return value of stdecide: 1 GO, 2 INVESTIGATE, 3 STOP; STDEC 1 holds the reason bits.
note Exit 0 = pass; otherwise the failing case number.

note the GO state: every bound below 1, coverage 5 of 10, C1..C11 detected, C12 reported
fn tdbase to void
streset
for s ulong 13
put STLO s 500000
put STHI s 500000
end
stcadd 4 17 10
stcadd 4 18 5
for c ulong 14
b = mul add c 1 8
put STCT b 1
if eq c 13
put STCT add b 3 1
else
put STCT add b 1 1
end
end
end

fn tdis d ulong bits ulong to bool
r = stdecide
if ne r d
ret false
end
ret eq get STDEC 1 bits
end

fn main to int
tdbase
if not tdis 1 0
ret 1
end
tdbase
stcadd 7 1 1
if not tdis 3 1
ret 2
end
tdbase
stcadd 0 1 1
if not tdis 1 0
ret 3
end
tdbase
stcadd 1 3 1
if not tdis 3 2
ret 4
end
tdbase
put STCT 34 1
if not tdis 3 4
ret 5
end
tdbase
put STCT 69 1
if not tdis 3 8
ret 6
end
tdbase
put STLO 4 1000000
put STHI 4 1000000
if not tdis 3 48
ret 7
end
tdbase
put STLO 4 999999
put STHI 4 1000000
if not tdis 2 32
ret 8
end
tdbase
put STHI 4 999999
if not tdis 1 0
ret 9
end
tdbase
put STHI 8 1000000
if not tdis 2 64
ret 10
end
tdbase
put STHI 9 1000000
if not tdis 2 128
ret 11
end
tdbase
put STCNT 146 4
if not tdis 2 256
ret 12
end
tdbase
put STCNT 145 0
put STCNT 146 0
if not tdis 2 256
ret 13
end
tdbase
put STCT 44 1
if not tdis 2 512
ret 14
end
tdbase
put STCT 48 0
put STCT 49 0
if not tdis 2 512
ret 15
end
tdbase
stcadd 5 1 1
put STCT 44 1
if not tdis 3 513
ret 16
end
tdbase
put STCT 115 0
put STCT 113 1
if not tdis 1 0
ret 17
end
tdbase
put STHI 10 1000000
put STLO 10 1000000
put STHI 11 1000000
put STHI 12 1000000
if not tdis 1 0
ret 18
end
ret 0
end
