note units: stats
note SPDX-License-Identifier: Apache-2.0
note stats-decide: the contract 10 decision (with K7 control outcomes) as a truth table over the
note globals stdecide reads. Every STOP, GO and INVESTIGATE branch and the boundary values
note (ppm 999999 versus 1000000, coverage exactly one half, no transfer QUERY) are covered, plus
note a missing (control, sub-case) pair (not run), K17 failed processes (END failure, nonzero
note exit: wrong refusal, STOP; echo is not scored) and the controls.log record checks
note (unknown sub-case and repeated pair refused with code 13).
note Return value of stdecide: 1 GO, 2 INVESTIGATE, 3 STOP; STDEC 1 holds the reason bits.
note Exit 0 = pass; otherwise the failing case number.

note the GO state: every bound below 1, coverage 5 of 10, C1..C11 detected, C12 reported, every
note required sub-case present
fn tdbase to void
streset
for s ulong 13
put STLO s 500000
put STHI s 500000
end
stcadd 4 17 10
stcadd 4 18 5
for c ulong 14
b = mul add c 1 8
put STCT b 1
put STCT add b 6 stcreq add c 1
if eq c 13
put STCT add b 3 1
else
put STCT add b 1 1
end
end
end

note controls.log record k in STFB: control c, sub-case s, outcome o
fn tdrec k ulong c ulong s ulong o ulong to void
v = new ulong 8 0
put v 0 c
put v 1 s
put v 2 o
for w ulong 8
tdword add mul k 64 mul w 8 get v w
end
end

note one little-endian word at byte p of STFB
fn tdword p ulong x ulong to void
for b ulong 8
put STFB add p b uchar and shr x mul b 8 255
end
end

note stctl1 on record 0 = (c, s, 1) after streset; returns STRF 2 when refused (13), 9 when
note accepted, 99 on another code
fn tdone c ulong s ulong to ulong
streset
tdrec 0 c s 1
e = stctl1 0
if eq e 0
ret 9
end
if ne e 13
ret 99
end
ret get STRF 2
end

note the 36 (control, sub-case) pairs of EvalJudge's controls run (controls-dev2/controls.log,
note confirmed by EvalJudge), written here independently of stcreq as control*10 + sub-case
text TDL "10 11 20 21 30 40 41 50 51 60 70 71 72 73 74 75 80 81 82 90 91 101 102 103 104 105 106 107 108 109 110 111 120 121 130 140 "

note every listed pair is accepted, no pair is missing, and there are exactly 36
fn tdlist to int
streset
k = ulong 0
v = ulong 0
for i ulong len TDL
c = get TDL i
if eq c 32
tdrec k div v 10 rem v 10 1
k = add k 1
v = 0
else
v = add mul v 10 ulong sub c 48
end
end
if ne k 36
ret 50
end
for j ulong k
if ne stctl1 j 0
ret 51
end
end
for c ulong 14
if ne stcmiss add c 1 0
ret 52
end
end
ret 0
end

fn tdctl to int
if ne tdone 3 1 2
ret 30
end
if ne tdone 10 0 2
ret 31
end
if ne tdone 10 10 2
ret 32
end
if ne tdone 7 5 9
ret 33
end
if ne tdone 10 9 9
ret 34
end
streset
tdrec 0 8 2 1
tdrec 1 8 2 1
if ne stctl1 0 0
ret 35
end
if or ne stctl1 1 13 ne get STRF 2 3
ret 36
end
if ne stcmiss 8 2
ret 37
end
if ne stcout 8 3
ret 38
end
ret 0
end

fn tdk17 to int
tdbase
stpexit 4 1024
if not tdis 3 2
ret 41
end
if or ne stc 4 27 1 ne stc 4 28 1
ret 42
end
tdbase
stpexit 7 1
if or not tdis 3 2 ne stc 7 27 0
ret 43
end
tdbase
stpexit 2 0
if or not tdis 1 0 ne stc 2 28 0
ret 44
end
tdbase
stpexit 0 9
if or not tdis 1 0 ne stc 0 28 1
ret 45
end
ret 0
end

fn tdis d ulong bits ulong to bool
r = stdecide
if ne r d
ret false
end
ret eq get STDEC 1 bits
end

fn main to int
tdbase
if not tdis 1 0
ret 1
end
tdbase
stcadd 7 1 1
if not tdis 3 1
ret 2
end
tdbase
stcadd 0 1 1
if not tdis 1 0
ret 3
end
tdbase
stcadd 1 3 1
if not tdis 3 2
ret 4
end
tdbase
put STCT 34 1
if not tdis 3 4
ret 5
end
tdbase
put STCT 69 1
if not tdis 3 8
ret 6
end
tdbase
put STLO 4 1000000
put STHI 4 1000000
if not tdis 3 48
ret 7
end
tdbase
put STLO 4 999999
put STHI 4 1000000
if not tdis 2 32
ret 8
end
tdbase
put STHI 4 999999
if not tdis 1 0
ret 9
end
tdbase
put STHI 8 1000000
if not tdis 2 64
ret 10
end
tdbase
put STHI 9 1000000
if not tdis 2 128
ret 11
end
tdbase
put STCNT 146 4
if not tdis 2 256
ret 12
end
tdbase
put STCNT 145 0
put STCNT 146 0
if not tdis 2 256
ret 13
end
tdbase
put STCT 44 1
if not tdis 2 512
ret 14
end
tdbase
put STCT 48 0
put STCT 49 0
if not tdis 2 512
ret 15
end
tdbase
stcadd 5 1 1
put STCT 44 1
if not tdis 3 513
ret 16
end
tdbase
put STCT 115 0
put STCT 113 1
if not tdis 1 0
ret 17
end
tdbase
put STHI 10 1000000
put STLO 10 1000000
put STHI 11 1000000
put STHI 12 1000000
if not tdis 1 0
ret 18
end
tdbase
put STCT 86 1020
if not tdis 2 512
ret 19
end
if ne stcmiss 10 1
ret 20
end
r = tdctl
if ne r 0
ret r
end
r = tdlist
if ne r 0
ret r
end
ret tdk17
end
