# tests/gates/rsi-test.gate
# Host fixture build in the repository's target directory, followed by the host test suite.
# Requires bubblewrap, a systemd user manager and cgroup v2 controllers; no root setup is performed.
gate: RSI-TEST
manifest_version: 2
owner: spark-rsi
requires:
  - host
inputs:
  - Cargo.toml
  - Cargo.lock
  - src/
  - tests/
  - examples/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["test"]
expects:
  exit: 0
  observe: ["prepopulate_rc == 0"]
  verdict: PASS
timeout: 40m
exactness: EXACT
cache_scope: machine
